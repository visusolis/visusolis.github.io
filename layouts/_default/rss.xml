{{- /* MAIN RSS feed */ -}}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
{{- $pages = where site.RegularPages "Params.rss_exclude" "!=" true }}
{{- if $.IsHome }}
{{- $pages = where $pages "Section" "in" (slice "w" "photos") }}
{{- end }}
{{- else }}
{{- $pages = $.Pages }}
{{- end }}
{{- partial "feed.html" (dict "page" . "pages" $pages) -}}
