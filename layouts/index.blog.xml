{{- /* Blog feed: everything in the main feed except tech and fiction. */ -}}
{{- $wpages := where site.RegularPages "Params.rss_exclude" "!=" true }}
{{- $wpages = where $wpages "Section" "eq" "w" }}
{{- $tagged := where $wpages "Params.tags" "intersect" (slice "tech" "fiction") }}
{{- $blog := complement $tagged $wpages | union (where site.RegularPages "Section" "eq" "photos") }}
{{- partial "feed.html" (dict "page" . "pages" $blog "format" "blog") -}}
